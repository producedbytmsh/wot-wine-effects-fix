+/* Opt-in compatibility workaround for WoT's prefab-effects availability check.
+ * Keep the real export table and every other process unchanged.  This is checked
+ * only after resolving the host-version function, including ordinal lookups.
+ */
+extern void CDECL wine_get_host_version( const char **sysname, const char **release );
+
+static BOOL hide_wot_host_version( void *proc )
+{
+    const RTL_USER_PROCESS_PARAMETERS *params;
+    const WCHAR *image, *basename, *p;
+    UNICODE_STRING variable = RTL_CONSTANT_STRING( L"WOT_HIDE_HOST_EXPORT" );
+    WCHAR enabled[2];
+    UNICODE_STRING value = { 0, sizeof(enabled), enabled };
+
+    if (proc != (void *)wine_get_host_version) return FALSE;
+    if (!(params = NtCurrentTeb()->Peb->ProcessParameters)) return FALSE;
+    if (!(image = params->ImagePathName.Buffer)) return FALSE;
+    basename = image;
+    for (p = image; p < image + params->ImagePathName.Length / sizeof(WCHAR); p++)
+        if (*p == '\\' || *p == '/') basename = p + 1;
+    if (wcsicmp( basename, L"WorldOfTanks.exe" )) return FALSE;
+    if (RtlQueryEnvironmentVariable_U( NULL, &variable, &value )) return FALSE;
+    return value.Length == sizeof(WCHAR) && enabled[0] == '1';
+}
